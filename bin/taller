#!/usr/bin/env bash
# Taller: proceso de desarrollo con varios agentes en Orca.
#
#   taller instalar             instala la skill para los agentes de esta máquina y el comando taller
#   taller actualizar           trae la última versión del repositorio y reinstala
#   taller agentes [--json] [--sin claude,...]
#                               qué modelo hará cada papel con lo que hay disponible
#   taller config               crea tu configuración propia (~/.config/taller/equipo.toml)
#   taller ruta                 carpeta del repositorio del taller (plantillas, configuración)
#   taller base --forja github|gitlab [--servicios] [--runbook] [--dir RUTA]
#                               aplica la base del estándar a un repositorio, sin sobrescribir nada
set -euo pipefail

raiz="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
plantillas="$raiz/plantillas"
config_propia="${TALLER_CONFIG:-$HOME/.config/taller/equipo.toml}"

uso() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

python_ok() {
  command -v python3 >/dev/null || { echo "Falta python3." >&2; exit 1; }
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' ||
    { echo "Hace falta Python 3.11 o superior." >&2; exit 1; }
}

instalar() {
  local destino
  for destino in "$HOME/.claude/skills" "$HOME/.agents/skills"; do
    mkdir -p "$destino"
    ln -sfn "$raiz/skills/taller" "$destino/taller"
    echo "Skill instalada en $destino/taller"
  done
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$raiz/bin/taller" "$HOME/.local/bin/taller"
  echo "Comando instalado en $HOME/.local/bin/taller"
  echo
  agentes
}

agentes() {
  python_ok
  python3 -I "$raiz/lib/equipo.py" --raiz "$raiz" "$@"
}

config() {
  if [ -f "$config_propia" ]; then
    echo "Ya existe: $config_propia"
  else
    mkdir -p "$(dirname "$config_propia")"
    {
      echo "# Tu configuración del equipo. Manda sobre la del repositorio ($raiz/equipo.toml)."
      echo "# Pon solo lo que quieras cambiar. Ejemplo:"
      echo "#"
      echo "# [papeles]"
      echo "# desarrollador = \"medio\""
      echo "#"
      echo "# [niveles]"
      echo "# barato = [\"opencode:deepseek/deepseek-chat\", \"claude:sonnet\"]"
    } > "$config_propia"
    echo "Creada: $config_propia"
  fi
}

base() {
  local forja="" servicios=0 runbook=0 dir="."
  while [ $# -gt 0 ]; do
    case "$1" in
      --forja) forja="${2:-}"; shift 2 ;;
      --servicios) servicios=1; shift ;;
      --runbook) runbook=1; shift ;;
      --dir) dir="${2:-}"; shift 2 ;;
      *) echo "Opción desconocida: $1" >&2; uso 64 ;;
    esac
  done
  case "$forja" in github|gitlab) ;; *) echo "Falta --forja github|gitlab" >&2; uso 64 ;; esac

  cd "$dir"
  if [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)" ]; then
    echo "Ejecútalo en la raíz de un repositorio git (git init primero)." >&2
    exit 1
  fi

  creados=(); omitidos=()
  copiar_arbol() {
    local origen="$1" archivo rel
    [ -d "$origen" ] || return 0
    while IFS= read -r -d '' archivo; do
      rel="${archivo#"$origen"/}"
      if [ -e "./$rel" ]; then
        omitidos+=("$rel")
      else
        mkdir -p "$(dirname "./$rel")"
        cp -p "$archivo" "./$rel"
        creados+=("$rel")
      fi
    done < <(find "$origen" -type f -print0 | sort -z)
  }
  copiar_arbol "$plantillas/comun"
  copiar_arbol "$plantillas/forja/$forja"
  copiar_arbol "$plantillas/docs"
  copiar_arbol "$plantillas/local"
  [ "$servicios" -eq 1 ] && copiar_arbol "$plantillas/servicios"
  [ "$runbook" -eq 1 ] && copiar_arbol "$plantillas/opcional/runbook"

  chmod +x .githooks/* scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
  git config core.hooksPath .githooks

  anadir_lineas() {
    local archivo="$1" linea; shift
    mkdir -p "$(dirname "$archivo")"; touch "$archivo"
    for linea in "$@"; do grep -qxF -- "$linea" "$archivo" || printf '%s\n' "$linea" >> "$archivo"; done
  }
  # Solo local: instrucciones y configuración de los agentes.
  anadir_lineas "$(git rev-parse --git-path info/exclude)" AGENTS.md CLAUDE.md CLAUDE.local.md .claude/ .worktreeinclude
  anadir_lineas .gitignore ".env*" "!.env.example" ".mise/" "mise.local.toml" ".DS_Store"

  echo "Base aplicada (forja: $forja)."
  [ "${#creados[@]}" -gt 0 ] && { echo "Creados:"; printf '  %s\n' "${creados[@]}"; }
  [ "${#omitidos[@]}" -gt 0 ] && { echo "Omitidos porque ya existían (revísalos a mano):"; printf '  %s\n' "${omitidos[@]}"; }
  local rastreados
  rastreados=$(git ls-files -- AGENTS.md CLAUDE.md CLAUDE.local.md .claude .worktreeinclude 2>/dev/null || true)
  if [ -n "$rastreados" ]; then
    echo "Aviso: estos archivos están en git y deberían salir del repositorio (git rm --cached):"
    printf '%s\n' "$rastreados" | sed 's/^/  /'
  fi
  echo "Pendiente de rellenar: los textos en MAYÚSCULAS y los comentarios <!-- --> de las plantillas."
}

actualizar() {
  git -C "$raiz" pull --ff-only
  instalar
}

case "${1:-}" in
  instalar) instalar ;;
  actualizar) actualizar ;;
  agentes) shift; agentes "$@" ;;
  config) config ;;
  ruta) echo "$raiz" ;;
  base) shift; base "$@" ;;
  -h|--help|"") uso ;;
  *) echo "Orden desconocida: $1" >&2; uso 64 ;;
esac
